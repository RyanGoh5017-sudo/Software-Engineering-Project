@page
@model RestuarantOrderSystem.Pages.Staff.ProfileModel
@{
    ViewData["Title"] = "Staff Profile";
}

<div class="container my-4">
    <h2><i class="bi bi-person-circle"></i> Staff Personal Profile</h2>
    <form method="post" class="card p-4 shadow-sm mt-4 col-md-6">
        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input asp-for="StaffUser.FullName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Phone Number</label>
            <input asp-for="StaffUser.PhoneNumber" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Save Profile</button>
    </form>
</div>