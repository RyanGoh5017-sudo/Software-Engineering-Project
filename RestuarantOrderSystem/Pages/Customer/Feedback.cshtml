@page
@model RestuarantOrderSystem.Pages.Customer.FeedbackModel
@{
    ViewData["Title"] = "Dining Feedback";
}

<div class="container my-4">
    <h2><i class="bi bi-star"></i> Submit Dining Feedback</h2>
    <form method="post" class="card p-4 shadow-sm mt-4 col-md-6">
        <div class="mb-3">
            <label class="form-label">Rating (1 to 5 Stars)</label>
            <select asp-for="NewFeedback.Rating" class="form-select">
                <option value="5">5 - Excellent</option>
                <option value="4">4 - Very Good</option>
                <option value="3">3 - Average</option>
                <option value="2">2 - Needs Improvement</option>
                <option value="1">1 - Poor</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Comments</label>
            <textarea asp-for="NewFeedback.Comments" class="form-control" rows="4" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Submit Review</button>
    </form>
</div>