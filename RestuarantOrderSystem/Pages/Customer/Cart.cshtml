@page
@model RestuarantOrderSystem.Pages.Customer.CartModel
@{
    ViewData["Title"] = "Order Cart";
}

<div class="container my-4">
    <h2>Shopping Cart</h2>
    @if (!Model.CartItems.Any())
    {
        <div class="alert alert-info mt-3">Your cart is empty. <a asp-page="/Customer/Menu">Browse Menu</a></div>
    }
    else
    {
        <table class="table align-middle mt-3">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CartItems)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>$@item.Price.ToString("F2")</td>
                        <td>@item.Quantity</td>
                        <td>$@((item.Price * item.Quantity).ToString("F2"))</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="card p-4 bg-light shadow-sm">
            <h4 class="d-flex justify-content-between">
                <span>Total Amount:</span>
                <span class="text-success">$@Model.TotalAmount.ToString("F2")</span>
            </h4>
            <hr />
            <form method="post" asp-page-handler="Checkout">
                <div class="mb-3">
                    <label class="form-label">Payment Method</label>
                    <select asp-for="PaymentMethod" class="form-select">
                        <option value="Credit Card">Credit Card</option>
                        <option value="Debit Card">Debit Card</option>
                        <option value="Cash">Cash</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-success btn-lg w-100">Pay & Confirm Order</button>
            </form>
        </div>
    }
</div>