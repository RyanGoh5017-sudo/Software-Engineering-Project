@page
@model RestuarantOrderSystem.Pages.Customer.ProfileModel
@{
    ViewData["Title"] = "Customer Profile";
}

<div class="container my-4">
    <h2><i class="bi bi-person-lines-fill"></i> Profile & Dining Preferences</h2>
    <form method="post" class="card p-4 shadow-sm mt-4 col-md-6">
        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input asp-for="CustomerUser.FullName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Phone Number</label>
            <input asp-for="CustomerUser.PhoneNumber" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Dietary Notes & Preferences</label>
            <textarea asp-for="CustomerUser.SpecialPreferences" class="form-control" rows="3" placeholder="Nut allergies, vegetarian, etc."></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Update Profile</button>
    </form>
</div>