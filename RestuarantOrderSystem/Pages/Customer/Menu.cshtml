@page
@model RestuarantOrderSystem.Pages.Customer.MenuModel
@{
    ViewData["Title"] = "Digital Menu";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Digital Menu</h2>
        <a asp-page="/Customer/Cart" class="btn btn-outline-success">
            <i class="bi bi-cart"></i> Cart (@Model.CartCount)
        </a>
    </div>

    <div class="row">
        @foreach (var item in Model.MenuItems)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 180px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title d-flex justify-content-between align-items-start">
                            <span>@item.Name</span>
                            <span class="text-end">
                                @if (item.IsPromotional && item.DiscountPrice > 0)
                                {
                                    <div class="text-decoration-line-through text-muted small">$@item.Price.ToString("F2")</div>
                                    <div class="text-success fw-bold">$@item.DiscountPrice.ToString("F2")</div>
                                }
                                else
                                {
                                    <span class="text-success">$@item.Price.ToString("F2")</span>
                                }
                            </span>
                        </h5>
                        <p class="card-text text-muted">@item.Description</p>
                        <div class="mt-auto">
                            <form method="post" asp-page-handler="AddToCart">
                                <input type="hidden" name="itemId" value="@item.MenuItemId" />
                                <button type="submit" class="btn btn-primary w-100" @(!item.IsAvailable ? "disabled" : "")>
                                    @(item.IsAvailable ? "Add to Cart" : "Sold Out")
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>