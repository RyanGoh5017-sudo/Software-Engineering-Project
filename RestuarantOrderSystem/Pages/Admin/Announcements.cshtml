@page
@model RestuarantOrderSystem.Pages.Admin.AnnouncementsModel
@{
    ViewData["Title"] = "Announcements";
}

<div class="container my-4">
    <h2><i class="bi bi-megaphone"></i> System Announcements & Promotions</h2>

    <div class="card p-3 my-4 shadow-sm">
        <h5>New Announcement</h5>
        <form method="post" class="row g-3">
            <div class="col-md-8">
                <input asp-for="NewAnnouncement.Title" class="form-control" placeholder="Title" required />
            </div>
            <div class="col-md-4">
                <div class="form-check mt-2">
                    <input asp-for="NewAnnouncement.IsPromotional" class="form-check-input" type="checkbox" />
                    <label class="form-check-label">Is Promotional Offer</label>
                </div>
            </div>
            <div class="col-12">
                <textarea asp-for="NewAnnouncement.Content" class="form-control" rows="3" placeholder="Announcement body..." required></textarea>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Publish Announcement</button>
            </div>
        </form>
    </div>
</div>