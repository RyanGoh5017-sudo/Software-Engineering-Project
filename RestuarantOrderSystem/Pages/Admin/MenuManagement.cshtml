@page
@model RestuarantOrderSystem.Pages.Admin.MenuManagementModel
@{
    ViewData["Title"] = "Menu Management";
}

<div class="container my-4">
    <h2 class="mb-4"><i class="bi bi-journal-plus me-2"></i>Menu Items & Promotional Offers</h2>

    <!-- Add / Edit Form Card -->
    <div class="card p-4 my-4 shadow-sm">
        <h4 class="mb-3" id="formTitle">Add New Menu Item</h4>
        <form method="post" enctype="multipart/form-data" asp-page-handler="Save" class="row g-3">
            <input type="hidden" id="MenuItemId" asp-for="MenuItem.MenuItemId" value="0" />

            <div class="col-md-3">
                <label class="form-label">Item Name</label>
                <input id="ItemName" asp-for="MenuItem.Name" class="form-control" placeholder="Item Name" required />
            </div>
            
            <div class="col-md-2">
                <label class="form-label">Price ($)</label>
                <input id="ItemPrice" asp-for="MenuItem.Price" type="number" step="0.01" class="form-control" placeholder="0.00" required />
            </div>

            <div class="col-md-2">
                <label class="form-label">Discount Price ($)</label>
                <input id="ItemDiscount" asp-for="MenuItem.DiscountPrice" type="number" step="0.01" class="form-control" placeholder="0.00" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Category</label>
                <select id="ItemCategory" asp-for="MenuItem.CategoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "CategoryId", "Name"))"></select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Item Image</label>
                <input type="file" asp-for="ImageFile" class="form-control" accept="image/*" />
            </div>

            <div class="col-md-12">
                <label class="form-label">Description</label>
                <textarea id="ItemDescription" asp-for="MenuItem.Description" class="form-control" rows="2" placeholder="Brief description of the dish..."></textarea>
            </div>

            <div class="col-md-3 d-flex align-items-center">
                <div class="form-check mt-2">
                    <input id="ItemAvailable" asp-for="MenuItem.IsAvailable" class="form-check-input" type="checkbox" checked />
                    <label class="form-check-label">Is Available</label>
                </div>
            </div>

            <div class="col-md-3 d-flex align-items-center">
                <div class="form-check mt-2">
                    <input id="ItemPromo" asp-for="MenuItem.IsPromotional" class="form-check-input" type="checkbox" />
                    <label class="form-check-label">Promotional Offer</label>
                </div>
            </div>

            <div class="col-md-6 text-end mt-4">
                <button type="submit" class="btn btn-success px-4" id="submitBtn">
                    <i class="bi bi-save me-1"></i> Save Item
                </button>
                <button type="button" class="btn btn-secondary px-3 d-none" id="cancelEditBtn" onclick="resetForm()">Cancel</button>
            </div>
        </form>
    </div>

    <!-- Menu Items Table -->
    <div class="card shadow-sm p-3">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.MenuItems != null && Model.MenuItems.Any())
                {
                    @foreach (var item in Model.MenuItems)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover;" class="rounded shadow-sm" />
                                }
                                else
                                {
                                    <span class="text-muted small">No Image</span>
                                }
                            </td>
                            <td class="fw-bold">@item.Name</td>
                            <td>@(item.Category?.Name ?? "Uncategorized")</td>
                            <td>
                                @if (item.IsPromotional && item.DiscountPrice > 0)
                                {
                                    <span class="text-decoration-line-through text-muted small">$@item.Price.ToString("F2")</span>
                                    <span class="text-success fw-bold ms-1">$@item.DiscountPrice.ToString("F2")</span>
                                }
                                else
                                {
                                    <span>$@item.Price.ToString("F2")</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(item.IsAvailable ? "bg-success" : "bg-danger")">
                                    @(item.IsAvailable ? "Available" : "Sold Out")
                                </span>
                                @if (item.IsPromotional)
                                {
                                    <span class="badge bg-warning text-dark ms-1">Promo</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-1" 
                                        onclick="editItem(@item.MenuItemId, '@item.Name', @item.Price, @item.DiscountPrice, @item.CategoryId, `@item.Description`, @item.IsAvailable.ToString().ToLower(), @item.IsPromotional.ToString().ToLower())">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.MenuItemId" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this menu item?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No menu items found. Add your first dish above!</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function editItem(id, name, price, discountPrice, categoryId, description, isAvailable, isPromotional) {
            document.getElementById('MenuItemId').value = id;
            document.getElementById('ItemName').value = name;
            document.getElementById('ItemPrice').value = price;
            document.getElementById('ItemDiscount').value = discountPrice;
            document.getElementById('ItemCategory').value = categoryId;
            document.getElementById('ItemDescription').value = description;
            document.getElementById('ItemAvailable').checked = isAvailable;
            document.getElementById('ItemPromo').checked = isPromotional;

            document.getElementById('formTitle').innerText = "Edit Menu Item";
            document.getElementById('submitBtn').innerHTML = "<i class='bi bi-save me-1'></i> Update Item";
            document.getElementById('cancelEditBtn').classList.remove('d-none');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function resetForm() {
            document.getElementById('MenuItemId').value = 0;
            document.getElementById('ItemName').value = '';
            document.getElementById('ItemPrice').value = '';
            document.getElementById('ItemDiscount').value = '';
            document.getElementById('ItemDescription').value = '';
            document.getElementById('ItemAvailable').checked = true;
            document.getElementById('ItemPromo').checked = false;

            document.getElementById('formTitle').innerText = "Add New Menu Item";
            document.getElementById('submitBtn').innerHTML = "<i class='bi bi-save me-1'></i> Save Item";
            document.getElementById('cancelEditBtn').classList.add('d-none');
        }
    </script>
}