<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gourmet Bistro RROMS</title>

    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 border-bottom shadow-sm">
            <div class="container-fluid px-lg-5">
                <a class="navbar-brand fw-bold text-success me-4" asp-page="/Customer/Menu">Gourmet Bistro RROMS</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <!-- Admin-Only Links -->
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-page="/Admin/Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-page="/Admin/MenuManagement"><i class="bi bi-card-checklist"></i> Menu Management</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-page="/Admin/UserManagement"><i class="bi bi-people"></i> Users</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-page="/Admin/Reports"><i class="bi bi-bar-chart"></i> Reports</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-page="/Admin/RestaurantSettings"><i class="bi bi-gear"></i> Settings</a>
                                </li>
                            }
                            else if (User.IsInRole("Staff"))
                            {
                                <!-- Staff-Only Links -->
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-page="/Staff/Orders"><i class="bi bi-list-task"></i> Kitchen / Orders</a>
                                </li>
                            }
                            else
                            {
                                <!-- Customer Links (Logged In) -->
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-page="/Customer/Menu"><i class="bi bi-book"></i> Menu</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-page="/Customer/Reservations"><i class="bi bi-calendar-check"></i> Book Table</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-page="/Customer/Orders"><i class="bi bi-receipt"></i> My Orders & History</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-page="/Customer/Cart"><i class="bi bi-cart"></i> Cart</a>
                                </li>
                            }
                        }
                        else
                        {
                            <!-- Default Customer Links for Guests -->
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-page="/Customer/Menu"><i class="bi bi-book"></i> Menu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-page="/Customer/Reservations"><i class="bi bi-calendar-check"></i> Book Table</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-page="/Customer/Cart"><i class="bi bi-cart"></i> Cart</a>
                            </li>
                        }
                    </ul>

                    <!-- Right Side Actions & Hamburger Portal -->
                    <ul class="navbar-nav align-items-lg-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="navbar-text text-light small me-2">Hello, @User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Customer/Logout" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-success btn-sm px-3" asp-page="/Customer/Login">Login / Guest</a>
                            </li>
                        }

                        <!-- Hamburger Dropdown Portal (Shows ONLY Staff Login & Admin Login) -->
                        <li class="nav-item dropdown ms-lg-2 ms-0 mt-2 mt-lg-0">
                            <a class="nav-link dropdown-toggle text-secondary small border border-secondary rounded px-2 py-1"
                               href="#" id="portalDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-list"></i> Portal Access
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="portalDropdown">
                                <li><a class="dropdown-item" asp-page="/Staff/Login"><i class="bi bi-person-badge me-2"></i>Staff Login</a></li>
                                <li><a class="dropdown-item" asp-page="/Admin/Login"><i class="bi bi-shield-lock me-2"></i>Admin Login</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>